---
import { getLangFromUrl, useFeaturesTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useFeaturesTranslations(lang);
---

<section class="bg-canvas-soft py-24 md:py-32">
  <div class="max-w-[1400px] mx-auto px-4 md:px-6">
    <!-- Section eyebrow + headline -->
    <div class="text-center mb-16">
      <span class="font-mono text-xs text-mute uppercase tracking-wider">
        {t('feat.eyebrow')}
      </span>
      <h2 class="mt-3 text-2xl md:text-3xl font-semibold tracking-[-0.03em] text-ink">
        {t('feat.title')}
      </h2>
    </div>

    <!-- Feature grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Feature 1 -->
      <div class="bg-canvas rounded-lg p-6 shadow-card hover:shadow-card-hover transition-shadow duration-200">
        <div class="w-10 h-10 rounded-md bg-canvas-soft-2 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-ink mb-2">{t('feat.f1.title')}</h3>
        <p class="text-sm text-body leading-relaxed">
          {t('feat.f1.desc')}
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="bg-canvas rounded-lg p-6 shadow-card hover:shadow-card-hover transition-shadow duration-200">
        <div class="w-10 h-10 rounded-md bg-canvas-soft-2 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-ink mb-2">{t('feat.f2.title')}</h3>
        <p class="text-sm text-body leading-relaxed">
          {t('feat.f2.desc')}
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="bg-canvas rounded-lg p-6 shadow-card hover:shadow-card-hover transition-shadow duration-200">
        <div class="w-10 h-10 rounded-md bg-canvas-soft-2 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-ink mb-2">{t('feat.f3.title')}</h3>
        <p class="text-sm text-body leading-relaxed">
          {t('feat.f3.desc')}
        </p>
      </div>
    </div>
  </div>
</section>
