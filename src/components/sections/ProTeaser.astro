---
import { WaitlistForm } from '../waitlist/WaitlistForm';
---

<section class="bg-canvas py-24 md:py-32 border-t border-hairline relative overflow-hidden" id="pro">
  <!-- Subtle background glow -->
  <div class="absolute inset-0 bg-gradient-to-b from-blue-500/5 to-transparent pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-[1400px] mx-auto px-4 md:px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 items-center">
      
      <!-- Copy side -->
      <div>
        <div class="inline-flex items-center gap-2.5 rounded-full bg-blue-500/10 border border-blue-500/20 px-4 py-1.5 mb-6">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse"></span>
          <span class="font-mono text-sm text-blue-600 dark:text-blue-400 uppercase tracking-wider font-semibold">
            Coming Soon
          </span>
        </div>
        
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.03em] text-ink leading-tight mb-6">
          Execute trades at the <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-cyan-500">speed of thought.</span>
        </h2>
        
        <p class="text-lg text-body leading-relaxed mb-8 max-w-lg">
          Tired of typing lot sizes manually? We're building a drag-and-drop position sizing tool that connects directly to MT5. Use your normal keyboard to execute lightning-fast hotkeys - no physical hardware required.
        </p>

        <ul class="space-y-4 mb-8">
          <li class="flex items-start gap-3">
            <svg class="w-6 h-6 text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span class="text-body font-medium">Drag & Drop lines on your MT5 charts</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-6 h-6 text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span class="text-body font-medium">Auto-calculates risk instantly before execution</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-6 h-6 text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span class="text-body font-medium">Keyboard hotkeys (Enter to execute, L for SL/TP lines, R to rotate risk, etc.)</span>
          </li>
        </ul>
      </div>

      <!-- Form side -->
      <div class="relative">
        <div class="absolute inset-0 bg-gradient-to-tr from-blue-500/20 to-purple-500/20 blur-3xl -z-10 rounded-full scale-90" aria-hidden="true"></div>
        <WaitlistForm client:visible />
      </div>

    </div>
  </div>
</section>
