---
/**
 * FAQ section - common questions about lot size calculation.
 * Helps with SEO and user education. Uses structured data-friendly format.
 */

import { getLangFromUrl } from '../../i18n/utils';
import { faqDict, useFAQTranslations } from '../../i18n/ui-faq';
const lang = getLangFromUrl(Astro.url);
const t = useFAQTranslations(lang);

const faqs = [
  { q: t('faq.q1'), a: t('faq.a1') },
  { q: t('faq.q2'), a: t('faq.a2') },
  { q: t('faq.q3'), a: t('faq.a3') },
  { q: t('faq.q4'), a: t('faq.a4') },
  { q: t('faq.q5'), a: t('faq.a5') },
  { q: t('faq.q6'), a: t('faq.a6') },
  { q: t('faq.q7'), a: t('faq.a7') },
  { q: t('faq.q8'), a: t('faq.a8') },
  { q: t('faq.q9'), a: t('faq.a9') },
  { q: t('faq.q10'), a: t('faq.a10') },
  { q: t('faq.q11'), a: t('faq.a11') },
  { q: t('faq.q12'), a: t('faq.a12') },
  { q: t('faq.q13'), a: t('faq.a13') },
  { q: t('faq.q14'), a: t('faq.a14') },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<section class="bg-canvas-soft py-24 md:py-32" id="faq">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="max-w-3xl mx-auto px-4 md:px-6">
    <div class="text-center mb-16">
      <span class="font-mono text-xs text-mute uppercase tracking-wider">FAQ</span>
      <h2 class="mt-3 text-2xl md:text-3xl font-semibold tracking-[-0.03em] text-ink">
        {t('faq.title')}
      </h2>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="group bg-canvas rounded-lg shadow-card">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-sm font-medium text-ink">
            {faq.q}
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div class="px-6 pb-4 text-sm text-body leading-relaxed" set:html={faq.a}></div>
        </details>
      ))}
    </div>
  </div>
</section>
