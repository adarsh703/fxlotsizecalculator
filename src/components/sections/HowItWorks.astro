---
/**
 * How It Works - 3-step guide section.
 * Dark polarity-flipped band per DESIGN.md pattern.
 */
---

<section id="how-it-works" class="bg-[#0a0a0a] text-white py-24 md:py-32 border-y border-hairline">
  <div class="max-w-[1400px] mx-auto px-4 md:px-6">
    <!-- Section header -->
    <div class="text-center mb-16">
      <span class="font-mono text-xs text-white/40 uppercase tracking-wider">
        How It Works
      </span>
      <h2 class="mt-3 text-2xl md:text-3xl font-semibold tracking-[-0.03em] text-white">
        Three steps. That's it.
      </h2>
    </div>

    <!-- Steps -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      <!-- Step 1 -->
      <div class="text-center">
        <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-4">
          <span class="font-mono text-lg font-semibold text-white">1</span>
        </div>
        <h3 class="text-base font-semibold text-white mb-2">Set your risk.</h3>
        <p class="text-sm text-white/60 leading-relaxed">
          Enter your account balance and how much you're willing to risk - as a percentage or fixed amount.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="text-center">
        <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-4">
          <span class="font-mono text-lg font-semibold text-white">2</span>
        </div>
        <h3 class="text-base font-semibold text-white mb-2">Define your stop loss.</h3>
        <p class="text-sm text-white/60 leading-relaxed">
          Enter SL distance in pips, or provide entry and stop loss prices. Or upload a TradingView screenshot.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="text-center">
        <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-4">
          <span class="font-mono text-lg font-semibold text-white">3</span>
        </div>
        <h3 class="text-base font-semibold text-white mb-2">Get your lot size.</h3>
        <p class="text-sm text-white/60 leading-relaxed">
          See standard, mini, and micro lots instantly. Copy the trade summary and place your trade with confidence.
        </p>
      </div>
    </div>
  </div>
</section>
