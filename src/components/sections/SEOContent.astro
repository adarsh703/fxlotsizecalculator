---
import { getLangFromUrl } from '../../i18n/utils';
import { useSeoTranslations } from '../../i18n/ui-seo';
const lang = getLangFromUrl(Astro.url);
const t = useSeoTranslations(lang);
---

<section class="py-20 bg-canvas text-ink">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-lg dark:prose-invert">
    <h2 class="text-3xl font-bold mb-6 text-center">{t('seo.title')}</h2>
    
    <p set:html={t('seo.p1')}></p>
    <p set:html={t('seo.p2')}></p>

    <h3 class="text-2xl font-semibold mt-10 mb-4">{t('seo.h2')}</h3>
    
    <p set:html={t('seo.p3')}></p>
    <p set:html={t('seo.p4')}></p>

    <h3 class="text-2xl font-semibold mt-10 mb-4">{t('seo.h3')}</h3>
    
    <p set:html={t('seo.p5')}></p>
    <p set:html={t('seo.p6')}></p>

    <h3 class="text-2xl font-semibold mt-10 mb-4">{t('seo.h4')}</h3>
    
    <p set:html={t('seo.p7')}></p>
    <p set:html={t('seo.p8')}></p>

    <h3 class="text-2xl font-semibold mt-10 mb-4">{t('seo.h5')}</h3>
    
    <p set:html={t('seo.p9')}></p>
    <p set:html={t('seo.p10')}></p>
    <p set:html={t('seo.p11')}></p>

    <h3 class="text-2xl font-semibold mt-10 mb-4">{t('seo.h6')}</h3>
    
    <p set:html={t('seo.p12')}></p>
    <p set:html={t('seo.p13')}></p>

    <h3 class="text-2xl font-semibold mt-10 mb-4">{t('seo.h7')}</h3>
    
    <ol class="list-decimal list-inside space-y-2 mt-4">
      <li set:html={t('seo.li1')}></li>
      <li set:html={t('seo.li2')}></li>
      <li set:html={t('seo.li3')}></li>
      <li set:html={t('seo.li4')}></li>
      <li set:html={t('seo.li5')}></li>
    </ol>

    <p class="mt-6" set:html={t('seo.p14')}></p>

    <h3 class="text-2xl font-semibold mt-10 mb-4">{t('seo.h8')}</h3>
    
    <p set:html={t('seo.p15')}></p>
    <p set:html={t('seo.p16')}></p>
  </div>
</section>
