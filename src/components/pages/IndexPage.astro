---
import Layout from '../../layouts/Layout.astro';
import Hero from '../sections/Hero.astro';
import Features from '../sections/Features.astro';
import ProTeaser from '../sections/ProTeaser.astro';
import HowItWorks from '../sections/HowItWorks.astro';
import FAQ from '../sections/FAQ.astro';
import SEOContent from '../sections/SEOContent.astro';
import { Calculator } from '../calculator/Calculator';
import { getLangFromUrl, useMetaTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const tm = useMetaTranslations(lang);
---

<Layout
  title={tm('home.title')}
  description={tm('home.desc')}
>
    <main>
    <Hero />
    <Calculator lang={lang} client:load />
    <ProTeaser />
    <Features />
    <HowItWorks />
    <SEOContent />
    <FAQ />
  </main>
  </Layout>
