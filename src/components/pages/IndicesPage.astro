---
import { getLangFromUrl, useMetaTranslations } from '../../i18n/utils';

import Layout from '../../layouts/Layout.astro';
import Hero from '../sections/Hero.astro';
import Features from '../sections/Features.astro';
import ProTeaser from '../sections/ProTeaser.astro';
import HowItWorks from '../sections/HowItWorks.astro';
import FAQ from '../sections/FAQ.astro';
import { Calculator } from '../calculator/Calculator';
const lang = getLangFromUrl(Astro.url);
const tm = useMetaTranslations(lang);

---

<Layout
  title="Indices & Futures Lot Size Calculator | US30 & NAS100"
  description="Determine the perfect position size for trading Indices and Futures. Use our free lot size calculator for US30, NAS100, and other major indices."
  keywords="indices lot size calculator, futures lot size calculator, us30 lot size calculator, lot size calculator futures, nas100 lot size calculator, dow jones position size"
  ogImage="/og-indices.png"
>
    <main>
    <Hero 
      eyebrow="US30 & NAS100 Lot Size Calculator"
      title="Calculate your <span class='text-purple-500'>Indices</span> lot size. Instantly."
      description="Calculate exact position sizes for US30, NAS100, SPX500 and other indices. Stop guessing your futures lot sizes."
    />
    <Calculator lang={lang} client:load initialInstrument="US30" />
    <ProTeaser />
    <Features />
    <HowItWorks />
    <FAQ />
  </main>
  </Layout>
