---
import { getLangFromUrl, useMetaTranslations } from '../../i18n/utils';

import Layout from '../../layouts/Layout.astro';
const lang = getLangFromUrl(Astro.url);
const tm = useMetaTranslations(lang);

---

<Layout 
  title="Contact Us | fxlotsizecalculator.com"
  description="Contact page is coming soon."
>
  <main class="max-w-3xl mx-auto px-6 py-24 text-center">
    <h1 class="text-3xl font-bold text-ink mb-8">Contact Us</h1>
    
    <div class="prose prose-slate dark:prose-invert max-w-none space-y-6 text-body mx-auto">
      <p class="text-lg">
        Our contact form is currently under construction. Please check back later!
      </p>
    </div>
  </main>
</Layout>
