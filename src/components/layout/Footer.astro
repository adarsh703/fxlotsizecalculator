---
import { getLangFromUrl, useTranslations, useFooterTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const tn = useTranslations(lang);
const t = useFooterTranslations(lang);
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<footer class="bg-canvas border-t border-hairline py-16 px-6 mt-auto">
  <div class="max-w-[1400px] mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-12">
      <div class="flex flex-col">
        <a href={`${prefix}/`} class="flex items-baseline mb-4">
          <span class="font-semibold text-ink tracking-tight text-lg">fxlotsizecalculator</span>
          <span class="text-mute text-sm ml-0.5">.com</span>
        </a>
        <p class="text-sm text-body">
          {t('footer.desc')}
        </p>
      </div>
      
      <div class="flex flex-col">
        <h3 class="font-mono text-xs uppercase tracking-wider text-mute mb-4">{t('footer.calc')}</h3>
        <ul class="flex flex-col gap-3">
          <li><a href={`${prefix}/`} class="text-sm text-body hover:text-ink transition-colors">Lot Size Calculator</a></li>
          <li><a href={`${prefix}/#how-it-works`} class="text-sm text-body hover:text-ink transition-colors">{tn('nav.howItWorks')}</a></li>
          <li><a href={`${prefix}/#faq`} class="text-sm text-body hover:text-ink transition-colors">{tn('nav.faq')}</a></li>
        </ul>
      </div>
      
      <div class="flex flex-col">
        <h3 class="font-mono text-xs uppercase tracking-wider text-mute mb-4">{t('footer.resources')}</h3>
        <ul class="flex flex-col gap-3">
          <li><a href={`${prefix}/forex`} class="text-sm text-body hover:text-ink transition-colors">{tn('nav.forex')}</a></li>
          <li><a href={`${prefix}/gold`} class="text-sm text-body hover:text-ink transition-colors">{tn('nav.gold')}</a></li>
          <li><a href={`${prefix}/indices`} class="text-sm text-body hover:text-ink transition-colors">{tn('nav.indices')}</a></li>
          <li><a href={`${prefix}/crypto`} class="text-sm text-body hover:text-ink transition-colors">{tn('nav.crypto')}</a></li>
          <li><a href={`${prefix}/futures`} class="text-sm text-body hover:text-ink transition-colors">{tn('nav.futures')}</a></li>
          <li><a href={`${prefix}/margin`} class="text-sm text-body hover:text-ink transition-colors">{tn('nav.margin')}</a></li>
          <li><a href={`${prefix}/swap`} class="text-sm text-body hover:text-ink transition-colors">{tn('nav.swap')}</a></li>
        </ul>
      </div>

      <div class="flex flex-col">
        <h3 class="font-mono text-xs uppercase tracking-wider text-mute mb-4">{t('footer.company')}</h3>
        <ul class="flex flex-col gap-3">
          <li><a href={`${prefix}/about`} class="text-sm text-body hover:text-ink transition-colors">{t('footer.about')}</a></li>
          <li><a href={`${prefix}/contact`} class="text-sm text-body hover:text-ink transition-colors">{t('footer.contact')}</a></li>
          <li><a href={`${prefix}/privacy`} class="text-sm text-body hover:text-ink transition-colors">{t('footer.privacy')}</a></li>
          <li><a href={`${prefix}/terms`} class="text-sm text-body hover:text-ink transition-colors">{t('footer.terms')}</a></li>
        </ul>
      </div>
    </div>
    
    <div class="border-t border-hairline mt-12 pt-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <p class="text-sm text-body">
        &copy; 2026 fxlotsizecalculator.com. {t('footer.rights')}
      </p>
      <p class="text-xs text-mute text-left md:text-right max-w-xl">
        {t('footer.disclaimer')}
      </p>
    </div>
  </div>
</footer>
