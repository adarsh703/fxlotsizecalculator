---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import ProTeaser from '../components/sections/ProTeaser.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import FAQ from '../components/sections/FAQ.astro';
import Footer from '../components/layout/Footer.astro';
import { Calculator } from '../components/calculator/Calculator';
---

<Layout
  title="Bitcoin & Crypto Lot Size Calculator | Trade BTC Risk-Free"
  description="Free Crypto and Bitcoin lot size calculator. Easily calculate position sizes in BTC, ETH, and other crypto assets to maintain proper risk management."
  keywords="bitcoin lot size calculator, crypto lot size calculator, crypto position size calculator, btc lot size calculator"
  ogImage="/og-crypto.png"
>
  <Navbar />
  <main>
    <Hero 
      eyebrow="Bitcoin & Crypto Position Sizing"
      title="Calculate your <span class='text-orange-500'>Crypto</span> lot size. Instantly."
      description="Navigate volatile cryptocurrency markets safely. Get exact position sizing for BTC, ETH and more."
    />
    <Calculator client:load initialInstrument="BTCUSD" />
    <ProTeaser />
    <Features />
    <HowItWorks />
    <FAQ />
  </main>
  <Footer />
</Layout>
