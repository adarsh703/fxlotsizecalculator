---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import ProTeaser from '../components/sections/ProTeaser.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import FAQ from '../components/sections/FAQ.astro';
import Footer from '../components/layout/Footer.astro';
import { Calculator } from '../components/calculator/Calculator';
---

<Layout
  title="Futures Lot Size Calculator | Oil, VIX, NQ, ES"
  description="Determine the perfect position size for trading Futures contracts. Use our free lot size calculator for VIX, Crude Oil, and other major futures."
  keywords="futures lot size calculator, oil lot size calculator, vix lot size calculator, futures margin calculator, position size calculator futures"
  ogImage="/og-futures.png"
>
  <Navbar />
  <main>
    <Hero 
      eyebrow="Futures Lot Size Calculator"
      title="Calculate your <span class='text-blue-500'>Futures</span> lot size. Instantly."
      description="Calculate exact position sizes for Oil, VIX, NQ, ES and other futures contracts. Stop guessing your risk."
    />
    <Calculator client:load initialInstrument="VIX" />
    <ProTeaser />
    <Features />
    <HowItWorks />
    <FAQ />
  </main>
  <Footer />
</Layout>
